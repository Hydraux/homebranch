# HomeBranch backend configuration
# This file is read by the homebranch systemd service.
# It is marked as a conffile — dpkg will preserve your edits on upgrade.

# Node
NODE_ENV=production

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=homebranch
DATABASE_PASSWORD=changeme
DATABASE_NAME=homebranch

# CORS
CORS_ORIGIN=http://localhost

# JWT (must match the authentication service)
JWT_ACCESS_SECRET=changeme

# File uploads
UPLOADS_DIRECTORY=/var/lib/homebranch/uploads

# Storage
STORAGE_LOCATION=local # or r2
APP_URL=http://localhost:3000

# R2 Storage (if STORAGE_LOCATION is r2)
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
